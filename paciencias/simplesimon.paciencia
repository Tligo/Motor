# uma carta move-se se o valor for imediatamente inferior
MOV TAB TAB <
# o mesmo para sequencias do mesmo naipe ordenadas decrescentemente
MOV TAB TAB +[m<
# qualquer carta/sequencia (mesmo naipe) pode ir para uma pilha vazia
MOV TAB TAB V
MOV TAB TAB +[mV
# sequencias completas K..A do mesmo naipe vao automaticamente para uma fundacao vazia
AUTO TAB FUND +[mKaV
WIN TAB 0
