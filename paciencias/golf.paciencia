JOGO Golf            # Esta Paciencia chama-se Golf
BARALHOS 1           # Joga-se com 1 baralho
TIPO TAB =           # Pilhas no tabuleiro tem as cartas todas visiveis
TIPO STOCK _         # Pilha de stock nao tem cartas visiveis
TIPO DESCARTE =      # Pilha de descarte mostra todas as cartas
INIT TAB 5           # 7 pilhas de tabuleiro, cada uma com 5 cartas
INIT TAB 5
INIT TAB 5
INIT TAB 5
INIT TAB 5
INIT TAB 5
INIT TAB 5
INIT DESCARTE 1      # Pilha de descarte comeca com 1 carta
INIT STOCK 16        # Pilha de stock comeca com 16 cartas
MOV STOCK DESCARTE * # Mover sempre do stock para o descarte
MOV TAB DESCARTE ~   # Do tabuleiro para o descarte se valor for -1/+1
WIN TAB 0            # Vitoria quando as pilhas do tabuleiro estiverem vazias
